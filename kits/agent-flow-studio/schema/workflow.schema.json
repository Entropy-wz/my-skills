{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-wz.local/my-skills/workflow.schema.json",
  "title": "Agent workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "nodes", "edges"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "const": "1" },
    "summary": { "type": "string" },
    "when": { "type": "array", "items": { "type": "string" } },
    "when_not": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "banned_actions": { "type": "array", "items": { "type": "string" } },
    "prompt": { "type": "string" },
    "preserve_agent_md": {
      "type": "boolean",
      "description": "When true, Save updates YAML/snapshot but does not regenerate AGENT.md (D1)"
    },
    "defaults": { "type": "object", "additionalProperties": true },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["step", "skill", "gate"] },
          "label": { "type": "string", "minLength": 1 },
          "ref": { "type": "string" },
          "notes": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    }
  }
}
