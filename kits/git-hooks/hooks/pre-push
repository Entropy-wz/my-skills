#!/usr/bin/env bash
# Block force-push and delete of main/master unless GIT_HOOKS_ALLOW_FORCE=1
set -euo pipefail

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue

  protected=0
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/master" ]]; then
    protected=1
  fi
  [[ "$protected" -eq 0 ]] && continue

  # Delete of protected branch
  if [[ "$local_sha" == "$zero" ]]; then
    if [[ "${GIT_HOOKS_ALLOW_FORCE:-}" != "1" ]]; then
      echo "git-hooks pre-push: refusing delete of $remote_ref" >&2
      echo "set GIT_HOOKS_ALLOW_FORCE=1 to override intentionally" >&2
      exit 1
    fi
    continue
  fi

  # Non-fast-forward / force to protected branch
  if [[ "$remote_sha" != "$zero" ]]; then
    if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      : # fast-forward OK
    else
      status=$?
      if [[ "${GIT_HOOKS_ALLOW_FORCE:-}" != "1" ]]; then
        if [[ "$status" -eq 1 ]]; then
          echo "git-hooks pre-push: refusing non-fast-forward to $remote_ref" >&2
        else
          echo "git-hooks pre-push: cannot verify ancestry for $remote_ref (fetch remote?); refusing" >&2
        fi
        echo "set GIT_HOOKS_ALLOW_FORCE=1 to override intentionally" >&2
        exit 1
      fi
    fi
  fi
done

exit 0
